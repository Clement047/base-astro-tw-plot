---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>

<html lang="fr">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>{title}</title>
  </head>

  <body>
    <header>
      <a class="logo" href="/">
        TP4 <span>Plot</span>
      </a>

      <nav>
        <a href="/">Accueil</a>

        <a href="/simple">
          Simple
        </a>

        <a href="/simple-penguin">
          Penguins
        </a>

        <a href="/penguin-filtre">
          Filtre
        </a>

        <a href="/penguin-multi-filtres">
          Multi-filtres
        </a>

        <a href="/cars-filtre">
          Cars
        </a>

        <a href="/weather-filtre">
          Weather
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    background: #0b0d14;
    color: #f7f7fa;
  }

  header {
    width: min(1200px, calc(100% - 48px));
    margin: auto;
    padding: 28px 0;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;

    border-bottom: 1px solid #262a38;
  }

  .logo {
    color: white;
    text-decoration: none;
    font-size: 22px;
    font-weight: 800;
  }

  .logo span {
    color: #8b7cff;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  nav a {
    color: #aaaeba;
    text-decoration: none;

    padding: 9px 13px;
    border-radius: 8px;

    transition: 0.2s;
  }

  nav a:hover {
    background: #191c28;
    color: white;
  }

  main {
    width: min(1200px, calc(100% - 48px));
    margin: auto;
    padding: 55px 0 80px;
  }

  h1 {
    margin: 0 0 12px;

    font-size: clamp(34px, 5vw, 58px);
    letter-spacing: -2px;
  }

  .intro {
    max-width: 700px;
    margin-bottom: 40px;

    color: #9da1ae;
    font-size: 18px;
    line-height: 1.6;
  }

  .plot-card {
    background: white;
    color: #111;

    border-radius: 18px;
    padding: 28px;

    overflow-x: auto;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;

    gap: 20px;
    margin-bottom: 28px;
  }

  .filter {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .filter label {
    color: #aeb2c0;

    font-size: 14px;
    font-weight: 600;
  }

  select {
    min-width: 180px;

    padding: 11px 14px;

    color: white;
    background: #171a24;

    border: 1px solid #303442;
    border-radius: 9px;

    font-size: 15px;
  }

  select:focus {
    outline: 2px solid #7768ff;
  }

  @media (max-width: 800px) {
    header {
      align-items: flex-start;
      flex-direction: column;
    }

    main {
      padding-top: 35px;
    }
  }
</style>