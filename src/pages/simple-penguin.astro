---
import TP4Layout from "../layouts/TP4Layout.astro";
---

<TP4Layout title="Simple Penguin - TP4 Observable Plot">
  <a href="/" class="retour">← Retour à l'accueil</a>

  <section class="header">
    <p class="eyebrow">DATA VISUALISATION</p>

    <h1>Simple Penguin</h1>

    <p class="description">
      Visualisation du dataset Penguins avec la longueur et la profondeur
      du bec, différenciées selon l'espèce.
    </p>
  </section>

  <section class="plot-card">
    <div id="plot"></div>
  </section>

  <script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../assets/penguins.json";

    const container =
      document.querySelector<HTMLDivElement>("#plot");

    function renderPlot() {
      if (!container) return;

      const graphique = Plot.plot({
        width: 1000,
        height: 520,

        marginTop: 40,
        marginRight: 30,
        marginBottom: 55,
        marginLeft: 70,

        color: {
          legend: true,
        },

        x: {
          label: "Longueur du bec (mm)",
          grid: true,
        },

        y: {
          label: "Profondeur du bec (mm)",
          grid: true,
        },

        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
            strokeWidth: 2,
            r: 4,
            tip: true,
          }),
        ],
      });

      container.replaceChildren(graphique);
    }

    renderPlot();
  </script>
</TP4Layout>

<style>
  .retour {
    display: inline-block;
    margin-bottom: 45px;
    color: #a9a9b8;
    text-decoration: none;
    transition: 0.2s;
  }

  .retour:hover {
    color: #8b6cff;
  }

  .header {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .eyebrow {
    color: #8b6cff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 12px;
  }

  .description {
    color: #a9a9b8;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .plot-card {
    background: white;
    border-radius: 24px;
    padding: 35px;
    overflow-x: auto;
  }

  #plot {
    min-width: 800px;
  }
</style>