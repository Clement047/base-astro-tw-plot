<h1>Simple</h1>

<div id="plot"></div>

<script>
  import * as Plot from "@observablehq/plot";

  const plot = Plot.rectY(
    { length: 10000 },
    Plot.binX(
      { y: "count" },
      { x: Math.random }
    )
  ).plot();

  const div = document.querySelector("#plot");

  div?.append(plot);
</script>