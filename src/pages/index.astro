---
import TP4Layout from "../layouts/TP4Layout.astro";

const exercices = [
  {
    numero: "01",
    titre: "Simple",
    description: "Premier graphique Observable Plot genere cote client.",
    lien: "/simple",
  },
  {
    numero: "02",
    titre: "Simple Penguin",
    description: "Visualisation du dataset Penguins avec Observable Plot.",
    lien: "/simple-penguin",
  },
  {
    numero: "03",
    titre: "Penguin avec filtre",
    description: "Filtrage dynamique des manchots selon leur espece.",
    lien: "/penguin-filtre",
  },
  {
    numero: "04",
    titre: "Penguin multi-filtres",
    description: "Filtres par espece, ile et sexe.",
    lien: "/penguin-multi-filtres",
  },
  {
    numero: "05",
    titre: "Cars avec filtre",
    description: "Visualisation automobile filtree par nombre de cylindres.",
    lien: "/cars-filtre",
  },
  {
    numero: "06",
    titre: "Weather avec filtre",
    description: "Evolution des temperatures selon les conditions meteorologiques.",
    lien: "/weather-filtre",
  },
];
---

<TP4Layout title="TP4 - Observable Plot">
  <section class="hero">
    <p class="tag">R3.12 - JavaScript cote client</p>

    <h1>
      Observable Plot<br />
      <span>cote client.</span>
    </h1>

    <p class="intro">
      Creation de graphiques interactifs avec Astro, JavaScript
      et Observable Plot.
    </p>
  </section>

  <section class="grid">
    {
      exercices.map((exercice) => (
        <a href={exercice.lien} class="card">
          <span class="number">{exercice.numero}</span>

          <div>
            <h2>{exercice.titre}</h2>
            <p>{exercice.description}</p>
          </div>

          <span class="arrow">→</span>
        </a>
      ))
    }
  </section>
</TP4Layout>

<style>
  .hero {
    padding: 35px 0 55px;
  }

  .tag {
    color: #8b7cff;
    font-weight: 700;
    margin-bottom: 15px;
  }

  h1 span {
    color: #777d91;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .card {
    min-height: 180px;
    padding: 26px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    background: #141720;
    border: 1px solid #252936;
    border-radius: 16px;

    color: white;
    text-decoration: none;

    transition: 0.2s;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: #7768ff;
    background: #181b27;
  }

  .number {
    color: #777d91;
    font-size: 13px;
    font-weight: bold;
  }

  h2 {
    margin: 20px 0 7px;
    font-size: 21px;
  }

  .card p {
    margin: 0;
    color: #969aa8;
    line-height: 1.5;
  }

  .arrow {
    align-self: flex-end;
    margin-top: 20px;
    color: #8b7cff;
    font-size: 25px;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>